{
  "name": "qynote-compilation",
  "version": "1.2.0",
  "private": true,
  "description": "Local-first knowledge health tools for Obsidian",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "check": "tsc -noEmit -skipLibCheck",
    "test": "vitest run",
    "test:obsidian": "node tests/obsidian-smoke.mjs",
    "mcp:build": "node mcp/build.mjs",
    "mcp:dist": "npm run mcp:build && node mcp/build-dist.mjs && node mcp/dist-smoke.mjs",
    "mcp:serve": "node mcp/server.mjs",
    "mcp:smoke": "node mcp/smoke.mjs && node mcp/atomic.mjs"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^22.10.0",
    "builtin-modules": "^5.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "obsidian": "^1.8.7",
    "tslib": "^2.8.1",
    "typescript": "^5.8.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "diff": "^9.0.0"
  }
}
